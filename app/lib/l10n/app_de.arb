{
  "@@locale": "de",

  "authSignInHeading": "Willkommen bei SGART",
  "@authSignInHeading": {
    "description": "Heading shown on the sign-in gate before a person has authenticated."
  },

  "authSignInButtonLabel": "Anmelden",
  "@authSignInButtonLabel": {
    "description": "Label of the button that starts the Keycloak Authorization Code + PKCE sign-in flow."
  },

  "authSignOutButtonLabel": "Abmelden",
  "@authSignOutButtonLabel": {
    "description": "Label of the button that signs the person out and clears the local session."
  },

  "authSignedInAsLabel": "Angemeldet als {displayName}",
  "@authSignedInAsLabel": {
    "description": "Shown on the authenticated placeholder screen with the live display name from GET /identity/me.",
    "placeholders": {
      "displayName": {
        "type": "String"
      }
    }
  },

  "authSignedInLabel": "Angemeldet",
  "@authSignedInLabel": {
    "description": "Shown on the authenticated placeholder screen when the token carries no display name (neither name nor preferred_username claim), instead of a trailing blank."
  },

  "unitPiece": "Stück",
  "@unitPiece": {
    "description": "Unit label for a single countable item."
  },
  "unitGram": "g",
  "@unitGram": {
    "description": "Unit label for grams."
  },
  "unitKilogram": "kg",
  "@unitKilogram": {
    "description": "Unit label for kilograms."
  },
  "unitMillilitre": "ml",
  "@unitMillilitre": {
    "description": "Unit label for millilitres."
  },
  "unitLitre": "l",
  "@unitLitre": {
    "description": "Unit label for litres."
  },
  "unitPack": "Pack",
  "@unitPack": {
    "description": "Unit label for a pack."
  },

  "errorGenericFallback": "Es ist ein Fehler aufgetreten. Bitte versuche es erneut.",
  "@errorGenericFallback": {
    "description": "Generic localized message shown when an error code is unknown or not yet mapped to specific copy."
  }
}
