{
  "realm": "sgart",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "sgart-app",
      "name": "SGART Flutter app",
      "description": "Public native client — Authorization Code + PKCE, no client secret on the device (NFR4).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "de.sgart.app://oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "de.sgart.app://oauth/callback"
      },
      "protocolMappers": [
        {
          "name": "sgart-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sgart-backend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sgart-web-invite",
      "name": "SGART invite web fallback",
      "description": "Public browser client for the Story 4.6 invite web-fallback page — Authorization Code + PKCE, isolated from sgart-app's native redirect/origin set. Dev redirect only; the production domain's redirect URI + web origin are a documented follow-up (docs/first-real-world-test.md).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/invite*"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sgart-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sgart-backend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sgart-admin",
      "name": "SGART Keycloak Admin lookup (dev)",
      "description": "Confidential client-credentials client for the Story 4.6 (D4) Keycloak Admin email→user lookup (KeycloakAdminFindHouseholdMemberByEmail). Local/dev only — enabling it requires SGART_IDENTITY_KEYCLOAK_ADMIN_ENABLED=true and matches the client-id sgart-admin/base-url/realm defaults in application.yaml. Production provisioning is a documented follow-up (docs/first-real-world-test.md) — never the app's public client, never a user password.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "local-dev-only-keycloak-admin-secret-change-me",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "anna@example.test",
      "email": "anna@example.test",
      "emailVerified": true,
      "firstName": "Anna",
      "lastName": "Testperson",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "anna-dev-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "ben@example.test",
      "email": "ben@example.test",
      "emailVerified": true,
      "firstName": "Ben",
      "lastName": "Testperson",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "ben-dev-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-sgart-admin",
      "enabled": true,
      "serviceAccountClientId": "sgart-admin",
      "clientRoles": {
        "realm-management": ["view-users"]
      }
    }
  ]
}
