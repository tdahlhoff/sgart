# Copy to .env and adjust for local development. DEV-ONLY credentials — never reuse in production.
# .env is gitignored so real secrets never enter version control.

# PostgreSQL (read model)
POSTGRES_USER=sgart
POSTGRES_PASSWORD=sgart_dev_password
POSTGRES_DB=sgart

# Keycloak bootstrap admin (dev)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# Keycloak realm "sgart" is imported from keycloak/realm-sgart.json on every `docker compose up`
# (--import-realm) — identical on every machine and in CI, nothing to click through manually.
#   Issuer:          http://localhost:8080/realms/sgart
#   JWKS:             http://localhost:8080/realms/sgart/protocol/openid-connect/certs
#   App client:       sgart-app (public, Authorization Code + PKCE S256, no secret)
#   Redirect URI:     de.sgart.app://oauth/callback
#   Dev sign-in users (synthetic, fake — never real personal data):
#     anna@example.test / anna-dev-password
#     ben@example.test  / ben-dev-password
