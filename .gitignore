# Claude Code
.claude/worktrees/
.claude/settings.local.json

# Local secrets / environment
.env

# Backend — Gradle / Java (the root module and every subproject, e.g. backend/keycloak-authenticator/)
backend/.gradle/
backend/build/
backend/bin/
backend/*/build/
backend/*/bin/

# Flutter / Dart client
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/pubspec.lock

# Android release signing — never commit the keystore or its passwords (docs/android-release-signing.md)
app/android/key.properties
app/android/*.jks
app/android/*.keystore

# Docker local volumes
.docker-data/

# Local run artifacts (scripts/start.sh: backend + emulator logs, pid files)
.run/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
